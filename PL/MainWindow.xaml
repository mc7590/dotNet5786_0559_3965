<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="850"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Closed"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Window.Resources>
        <!--this window's texbox style-->
        <Style TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="MaxWidth" Value="150"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFECEC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!--this window's label style-->
        <Style TargetType="Label">
            <Setter Property="Background" Value="#FF6B6B"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <!--<Window.Background>
        <ImageBrush ImageSource="Resources/logo.jpg"
                Stretch="UniformToFill"
                Opacity="0.5"/>
    </Window.Background>-->

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- System Clock -->
            <RowDefinition Height="*"/>
            <!-- Configuration -->
            <RowDefinition Height="Auto"/>
            <!-- Database Buttons -->
        </Grid.RowDefinitions>

               <!--1) System Clock Area-->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- System clock display -->
            <Border Grid.Column="1"
                    Background="#ED1C24"
                    Padding="10"
                    CornerRadius="18"
                    HorizontalAlignment="Center">
                <Label Content="{Binding CurrentTime}"
                    FontSize="25"
                       FontWeight="Bold"
                       Foreground="White"
                       Background="#ED1C24"/>
            </Border>

            <!-- Time adjustment buttons -->
            <StackPanel Grid.Row="1"
            Grid.Column="1"
            Margin="0,10,0,0"
            Height="36" 
            Orientation="Horizontal"
            HorizontalAlignment="Center">

                <Button Content="+1 Minute" Margin="3" Height="28" MaxWidth="100" Click="BtnAddOneMinute_Click"/>
                <Button Content="+1 Hour" Margin="3" Height="28" MaxWidth="100" Click="BtnAddOneHour_Click"/>
                <Button Content="+1 Day" Margin="3" Height="28" MaxWidth="100" Click="BtnAddOneDay_Click"/>
                <Button Content="+1 Month" Margin="3" Height="28" MaxWidth="100" Click="BtnAddOneMonth_Click"/>
                <Button Content="+1 Year" Margin="3" Height="28" MaxWidth="100" Click="BtnAddOneYear_Click"/>
            </StackPanel>
        </Grid>

               <!--2) Configuration Area (SCROLLABLE)-->
        <Grid Grid.Row="1" Margin="0,10,0,10" Background="Transparent">

            <Image Source="Resources/logo.jpg" 
           Stretch="UniformToFill" 
           Opacity="0.3" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Center"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">

                <Grid Background="Transparent">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Ave Car Speed:" Foreground="Black"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Configuration.AveCarSpeedKmH, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Ave Motorcycle Speed:" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Configuration.AveMotorcycleSpeedKmH, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Ave Bicycle Speed:" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Configuration.AveBicycleSpeedKmH, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Ave Walking Speed:" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Configuration.AveWalkingSpeedKmH, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Max Delivery Time:" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Configuration.GetMaxDeliveryTime, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Risk Range:" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Configuration.RiskRange, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="Inactivity Threshold:" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Configuration.InactivityThreshold, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Grid.Row="7" Grid.Column="1" Margin="5" Content="Update" Click="SaveConfigurationCommand" Width="100" HorizontalAlignment="Left"/>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!--3) DATABASE CONTROL AREA-->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--Reset Database-->
            <Button Grid.Column="0"
                    Content="Reset Database"
                    Click="BtnResetDB_Click"
                    Margin="10" Height="45" MinWidth="170"/>

            <!--Initialize Database-->
            <Button Grid.Column="1"
                    Content="Initialize Database"
                    Click="BtnInitializeDB_Click"
                    Margin="10" Height="45"  MinWidth="170"/>

            <!--Handle Couriers list-->
            <Button Grid.Column="2"
                    Content="Handle Couriers"
                    Click="BtnCouriers_Click"
                    Margin="10" Height="45" MinWidth="170"/>

            <!--Handle Orders list-->
            <Button Grid.Column="3"
                    Content="Handle Orders"
                    Click="BtnOrders_Click"
                    Margin="10" Height="45" MinWidth="170"/>
        </Grid>

    </Grid>
</Window>
