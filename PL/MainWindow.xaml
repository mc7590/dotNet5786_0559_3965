<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="850"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Closed">
    <Window.Background>
        <ImageBrush ImageSource="Resources/logo.jpg"
                Stretch="UniformToFill"
                Opacity="0.5"/>
    </Window.Background>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- System Clock -->
            <RowDefinition Height="*"/>
            <!-- Configuration -->
            <RowDefinition Height="Auto"/>
            <!-- Database Buttons -->
        </Grid.RowDefinitions>

               <!--1) System Clock Area-->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- System clock display -->
            <Border Grid.Column="1"
                    Background="#ED1C24"
                    Padding="12"
                    CornerRadius="18"
                    HorizontalAlignment="Center">
                <Label Content="{Binding CurrentTime}"
                    FontSize="25"
                       FontWeight="Bold"
                       Foreground="White"/>
            </Border>

            <!-- Time adjustment buttons -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Width="150">
                <Button Content="Add 1 Minute" Margin="3" Click="BtnAddOneMinute_Click"/>
                <Button Content="Add 1 Hour" Margin="3" Click="BtnAddOneHour_Click"/>
                <Button Content="Add 1 Day" Margin="3" Click="BtnAddOneDay_Click"/>
                <Button Content="Add 1 Month" Margin="3" Click="BtnAddOneMonth_Click"/>
                <Button Content="Add 1 Year" Margin="3" Click="BtnAddOneYear_Click"/>
            </StackPanel>
        </Grid>

               <!--2) Configuration Area (SCROLLABLE)-->
        <ScrollViewer Grid.Row="1" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <!-- Label -->
                    <ColumnDefinition Width="*"/>
                    <!-- TextBox -->
                </Grid.ColumnDefinitions>

                <!-- Configuration Fields -->
                <Label Grid.Row="0" Grid.Column="0" Content="Ave Car Speed:" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding Configuration.AveCarSpeedKmH, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Ave Motorcycle Speed:" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Text="{Binding Configuration.AveMotorcycleSpeedKmH, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Ave Bicycle Speed:" Margin="5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Text="{Binding Configuration.AveBicycleSpeedKmH, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Ave Walking Speed:" Margin="5"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="5" Text="{Binding Configuration.AveWalkingSpeedKmH, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Max Delivery Time:" Margin="5"/>
                <TextBox Grid.Row="4" Grid.Column="1" Margin="5" Text="{Binding Configuration.GetMaxDeliveryTime, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Risk Range:" Margin="5"/>
                <TextBox Grid.Row="5" Grid.Column="1" Margin="5" Text="{Binding Configuration.RiskRange, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Grid.Row="6" Grid.Column="0" Content="Inactivity Threshold:" Margin="5"/>
                <TextBox Grid.Row="6" Grid.Column="1" Margin="5" Text="{Binding Configuration.InactivityThreshold, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Row="7" Grid.Column="1" Margin="5" Content="Update" Click="SaveConfigurationCommand"/>
            </Grid>
        </ScrollViewer>

               <!--3) DATABASE CONTROL AREA-->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--Reset Database-->
            <Button Grid.Column="0"
                    Content="Reset Database"
                    Click="BtnResetDB_Click"
                    Margin="10" Height="45"/>

            <!--Initialize Database-->
            <Button Grid.Column="1"
                    Content="Initialize Database"
                    Click="BtnInitializeDB_Click"
                    Margin="10" Height="45"/>

            <!--Handle Couriers list-->
            <Button Grid.Column="2"
                    Content="Handle Couriers"
                    Click="BtnCouriers_Click"
                    Margin="10" Height="45"/>

            <!--Handle Orders list-->
            <Button Grid.Column="3"
                    Content="Handle Orders"
                    Click="BtnOrders_Click"
                    Margin="10" Height="45"/>
        </Grid>

    </Grid>
</Window>
