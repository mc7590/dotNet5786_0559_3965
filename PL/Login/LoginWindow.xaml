<Window x:Class="PL.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Burger Ranch Admin" Height="550" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E31E24" Offset="0.0"/>
                <GradientStop Color="#F37021" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top" 
                 Margin="0,-100,-100,0" Fill="White" Opacity="0.1"/>
        <Ellipse Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                 Margin="-50,0,0,-50" Fill="Yellow" Opacity="0.1"/>

        <Border Width="320" Height="420" Background="White" CornerRadius="20"
                VerticalAlignment="Center" HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="10" Opacity="0.3" BlurRadius="20"/>
            </Border.Effect>

            <StackPanel Margin="30">

                <TextBlock Text="BURGER RANCH" FontWeight="Bold" FontSize="28" 
                           Foreground="#E31E24" HorizontalAlignment="Center" Margin="0,0,0,10"
                           FontFamily="Arial Black"/>

                <TextBlock Text="Management System" FontSize="14" Foreground="Gray" 
                           HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Label Content="ID Number" FontWeight="SemiBold" Margin="0,15,0,0"/>
                <TextBox x:Name="txtId" Height="35" VerticalContentAlignment="Center" 
                         Padding="5" BorderBrush="#E31E24" BorderThickness="0,0,0,2"
                         Text="{Binding IdText, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Password" FontWeight="SemiBold" Margin="0,15,0,0"/>
                <PasswordBox x:Name="txtPassword" Height="35" VerticalContentAlignment="Center" 
                             Padding="5" BorderBrush="#E31E24" BorderThickness="0,0,0,2"
                             PasswordChanged="Password_Changed"/>

                <Button Content="LOGIN" Height="45" Margin="0,40,0,0"
                        Click="BtnLogin_Click"
                        IsEnabled="{Binding CanLogin}"
                        FontSize="16" FontWeight="Bold" Cursor="Hand">
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
