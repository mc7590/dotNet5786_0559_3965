<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        xmlns:pl="clr-namespace:PL"
        mc:Ignorable="d"
        Title="CourierListWindow" Height="640" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    
    <Window.Resources>
        <pl:ConvertDelMethodToBrush x:Key="DelMethodToBrush"/>
        <pl:ConvertIsActiveToBrush x:Key="IsActiveToBrush"/>
    </Window.Resources>
    
    <!--External Grid-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="500*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Internal, Upper Grid-->
        <Grid HorizontalAlignment="Stretch" Height="auto" Grid.Row="0" VerticalAlignment="Stretch" Width="auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Filter By:" HorizontalAlignment="Left" Margin="185,0,0,0" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ItemsSource="{Binding Source={StaticResource MethodDeliveryCollectionKey}}"
                      SelectedItem="{Binding FilterByMethod, Mode=TwoWay}"
                      SelectionChanged="ComboBox_SelectionChanged"/>
        </Grid>
        
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding CourierList}"
                  IsReadOnly ="True"
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True"
                  RowHeight="40"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="LightGray"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  MouseDoubleClick="dgCourierList_MouseDoubleClick"
                  SelectedItem="{Binding SelectedCourier}">

            <DataGrid.RowStyle>
                <!--property trigger-->
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFECEC" />
                            <Setter Property="BorderBrush" Value="#FFECEC" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="Courier ID" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding Name}" Header="Courier Name" Width="Auto"/>
                
                <DataGridTemplateColumn Header="Is Active" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="10,2" Margin="5" HorizontalAlignment="Center" CornerRadius="12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{Binding Active, Converter={StaticResource IsActiveToBrush}}"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                        <Setter Property="ToolTip" Value="An active courier in this program"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <!--Data Trigger-->
                                            <DataTrigger Binding="{Binding Active}" Value="False">
                                                <Setter Property="ToolTip" Value="Not active courier in the program anymore"/>
                                                <Setter Property="Opacity" Value="0.8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <CheckBox IsChecked="{Binding Active}"
                                          IsHitTestVisible="False"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Delivery Method" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding DeliveryMethod, Converter={StaticResource DelMethodToBrush}}" 
                            CornerRadius="14" 
                            Padding="10,2" 
                            Margin="5"
                            HorizontalAlignment="Center"
                            MinWidth="100">
                                <TextBlock Text="{Binding DeliveryMethod}" 
                                   FontWeight="Light"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Binding="{Binding StartedWorking}" Header="Started Working" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding TotalOnTimeDeliveries}" Header="Total On Time Deliveries" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding TotalLateDeliveries}" Header="Total Late Deliveries" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding OrdersInProgressId}" Header="Orders In Progress Id" Width="Auto"/>
                <DataGridTemplateColumn Header="Actions" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                          <Button Content="Delete"
                                  Click="DeleteCourier_Click"
                                  Padding="6,2" Height="28" Width="70"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            
        </DataGrid>

        <Button Content="Add" Grid.Row="2" HorizontalAlignment="Center" Height="50" Width="150" Click="BtnAdd_Click" />
    </Grid>
</Window>
