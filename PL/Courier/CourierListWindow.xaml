<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        xmlns:pl="clr-namespace:PL"
        mc:Ignorable="d"
        Title="CourierListWindow" Height="640" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    
    <Window.Resources>
        <pl:ConvertDelMethodToBrush x:Key="DelMethodToBrush"/>
        <pl:ConvertIsActiveToBrush x:Key="IsActiveToBrush"/>
    </Window.Resources>
    
    <!--External Grid-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="500*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Internal, Upper Grid-->
        <Grid HorizontalAlignment="Stretch" Height="auto" Grid.Row="0" VerticalAlignment="Stretch" Width="auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Filter By:" HorizontalAlignment="Left" Margin="185,0,0,0" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ItemsSource="{Binding Source={StaticResource MethodDeliveryCollectionKey}}"
                      SelectedItem="{Binding MethodDelivery, Mode=TwoWay}"/>
        </Grid>
        
        <DataGrid Grid.Row="1" 
          ItemsSource="{Binding CourierList}"
          IsReadOnly ="True"
          AutoGenerateColumns="False" 
          EnableRowVirtualization="True"
          RowDetailsVisibilityMode="VisibleWhenSelected"
          MouseDoubleClick="dgCourierList_MouseDoubleClick"
          SelectedItem="{Binding SelectedCourier}">

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="Courier ID" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding Name}" Header="Courier Name" Width="Auto"/>
                
                <DataGridTemplateColumn Header="Is Active" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--<CheckBox IsEnabled="False" IsChecked="{Binding Active}" />-->
                            <Border Background="{Binding Active, Converter={StaticResource IsActiveToBrush}}"
                                    Padding="10,2" 
                                    Margin="5"
                                    HorizontalAlignment="Center">

                                <CheckBox IsEnabled="False"
                                          IsChecked="{Binding Active}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTemplateColumn Header="Delivery Method" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding DeliveryMethod, Converter={StaticResource DelMethodToBrush}}" 
                            CornerRadius="14" 
                            Padding="10,2" 
                            Margin="5"
                            HorizontalAlignment="Center"
                            MinWidth="100">
                                <TextBlock Text="{Binding DeliveryMethod}" 
                                   FontWeight="Light"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Binding="{Binding StartedWorking}" Header="Started Working" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding TotalOnTimeDeliveries}" Header="Total On Time Deliveries" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding TotalLateDeliveries}" Header="Total Late Deliveries" Width="Auto"/>
                <DataGridTextColumn Binding="{Binding OrdersInProgressId}" Header="Orders In Progress Id" Width="Auto"/>
                <DataGridTemplateColumn Header="Actions" Width="Auto">
                <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                          <Button Content="Delete"
                                  Click="DeleteCourier_Click"
                                  Padding="6,2"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            
        </DataGrid>

        <Button Content="Add" Grid.Row="2" HorizontalAlignment="Center" Height="50" Width="100" Click="BtnAdd_Click" />
    </Grid>
</Window>
