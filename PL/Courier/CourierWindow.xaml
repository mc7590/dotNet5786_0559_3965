<!--<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        xmlns:pl="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Courier Window" Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    --><!-- RESOURCES WITH CONVERTERS --><!--
    <Window.Resources>
        <pl:ConvertModeToReadOnly x:Key="ModeToReadOnly"/>
        <pl:ConvertModeToVisibility x:Key="ModeToVisibility"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                --><!-- Label --><!--
                <ColumnDefinition Width="*"/>
                --><!-- TextBox / ComboBox --><!--
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                --><!-- ID --><!--
                <RowDefinition Height="30"/>
                --><!-- Name --><!--
                <RowDefinition Height="30"/>
                --><!-- Phone --><!--
                <RowDefinition Height="30"/>
                --><!-- Email --><!--
                <RowDefinition Height="30"/>
                --><!-- Password --><!--
                <RowDefinition Height="30"/>
                --><!-- Active --><!--
                <RowDefinition Height="30"/>
                --><!-- Delivery Method --><!--
                <RowDefinition Height="30"/>
                --><!-- Started Working --><!--
                <RowDefinition Height="30"/>
                --><!-- Max Distance --><!--
                <RowDefinition Height="30"/>
                --><!-- On Time Deliveries --><!--
                <RowDefinition Height="30"/>
                --><!-- Late Deliveries --><!--
                <RowDefinition Height="10"/>
                --><!-- רווח לפני GroupBox --><!--
                <RowDefinition Height="*"/>
                --><!-- GroupBox "Order In Progress" --><!--
                <RowDefinition Height="10"/>
                --><!-- רווח לפני Buttons --><!--
                <RowDefinition Height="Auto"/>
                --><!-- Buttons Select Order / History --><!--
            </Grid.RowDefinitions>


            --><!-- ID --><!--
            <Label Grid.Row="0" Grid.Column="0" Content="ID:"/>
            <TextBox Grid.Row="0" Grid.Column="1" 
                 Text="{Binding CurrentCourier.Id, Mode=TwoWay}" 
                 Background="#F0F0F0"
                 IsReadOnly="{Binding ElementName=btnAddUpdate,
                                      Path=Content,
                                      Converter={StaticResource ModeToReadOnly}}"/>

            --><!-- NAME --><!--
            <Label Grid.Row="1" Grid.Column="0" Content="Name:"/>
            <TextBox Grid.Row="1" Grid.Column="1" 
                 Text="{Binding CurrentCourier.Name, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            --><!-- PHONE --><!--
            <Label Grid.Row="2" Grid.Column="0" Content="Phone:"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                 Text="{Binding CurrentCourier.CourierPhone, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            --><!-- EMAIL --><!--
            <Label Grid.Row="3" Grid.Column="0" Content="Email:"/>
            <TextBox Grid.Row="3" Grid.Column="1" 
                 Text="{Binding CurrentCourier.Email, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            --><!-- PASSWORD --><!--
            <Label Grid.Row="4" Grid.Column="0" Content="Password:"/>
            <TextBox Grid.Row="4" Grid.Column="1" 
                 Text="{Binding CurrentCourier.Password, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            --><!-- ACTIVE --><!--
            <Label Grid.Row="5" Grid.Column="0" Content="Active:"/>
            <CheckBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="5"
                  IsChecked="{Binding CurrentCourier.Active, Mode=TwoWay}"/>

            --><!-- DELIVERY METHOD --><!--
            <Label Grid.Row="6" Grid.Column="0" Content="Delivery Method:"/>
            <ComboBox Grid.Row="6" Grid.Column="1"
                  ItemsSource="{Binding Source={StaticResource MethodDeliveryCollectionKey}}"
                  SelectedItem="{Binding CurrentCourier.DeliveryMethod, Mode=TwoWay}"/>

            --><!-- STARTED WORKING --><!--
            <Label Grid.Row="7" Grid.Column="0" Content="Started Working:"/>
            <DatePicker Grid.Row="7" Grid.Column="1" Margin="5" VerticalAlignment="Center"
                    SelectedDate="{Binding CurrentCourier.StartedWorking, Mode=TwoWay}" 
                    IsEnabled="False"/>

            --><!-- MAX DISTANCE --><!--
            <Label Grid.Row="8" Grid.Column="0" Content="Max Distance:"/>
            <TextBox Grid.Row="8" Grid.Column="1" 
                 Text="{Binding CurrentCourier.MaxPersonalDistance, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            --><!-- ON TIME DELIVERIES --><!--
            <Label Grid.Row="9" Grid.Column="0" Content="On Time Deliveries:"
               Visibility="{Binding ElementName=btnAddUpdate,
                                   Path=Content,
                                   Converter={StaticResource ModeToVisibility}}"/>

            <TextBox Grid.Row="9" Grid.Column="1" 
                 Text="{Binding CurrentCourier.TotalOnTimeDeliveries, Mode=OneWay}" 
                 IsReadOnly="True" Background="#F0F0F0"
                 Visibility="{Binding ElementName=btnAddUpdate,
                                     Path=Content,
                                     Converter={StaticResource ModeToVisibility}}"/>

            --><!-- LATE DELIVERIES --><!--
            <Label Grid.Row="10" Grid.Column="0" Content="Late Deliveries:"
               Visibility="{Binding ElementName=btnAddUpdate,
                                   Path=Content,
                                   Converter={StaticResource ModeToVisibility}}"/>

            <TextBox Grid.Row="10" Grid.Column="1" 
                 Text="{Binding CurrentCourier.TotalLateDeliveries, Mode=OneWay}" 
                 IsReadOnly="True" Background="#F0F0F0"
                 Visibility="{Binding ElementName=btnAddUpdate,
                                     Path=Content,
                                     Converter={StaticResource ModeToVisibility}}"/>

            <GroupBox Header="Order In Progress"         
                      Grid.Row="11" Grid.ColumnSpan="2" Margin="10"
                      Visibility="{Binding CurrentCourier.ActiveDeliveryOrder,
                               Converter={StaticResource NullToVisibility}}">
                    <Grid DataContext="{Binding CurrentCourier.ActiveDeliveryOrder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            --><!-- DeliveryId --><!--
                            <Label Grid.Row="0" Grid.Column="0" Content="Delivery ID:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeliveryId}"/>

                            --><!-- OrderId --><!--
                            <Label Grid.Row="1" Grid.Column="0" Content="Order ID:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OrderId}"/>

                            --><!-- OrderType --><!--
                            <Label Grid.Row="2" Grid.Column="0" Content="Order Type:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrderType}"/>

                            --><!-- Description --><!--
                            <Label Grid.Row="3" Grid.Column="0" Content="Description:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Description}"/>

                            --><!-- Address --><!--
                            <Label Grid.Row="4" Grid.Column="0" Content="Address:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Address}"/>

                            --><!-- AerialDistance --><!--
                            <Label Grid.Row="5" Grid.Column="0" Content="Aerial Distance:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AerialDistance}"/>

                            --><!-- ActualDistance --><!--
                            <Label Grid.Row="6" Grid.Column="0" Content="Actual Distance:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ActualDistance}"/>

                            --><!-- CustomerName --><!--
                            <Label Grid.Row="7" Grid.Column="0" Content="Customer Name:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CustomerName}"/>

                            --><!-- CustomerPhone --><!--
                            <Label Grid.Row="8" Grid.Column="0" Content="Customer Phone:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CustomerPhone}"/>

                            --><!-- ExpectedDeliveryTime --><!--
                            <Label Grid.Row="9" Grid.Column="0" Content="Expected Delivery Time:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ExpectedDeliveryTime, StringFormat=\{0:dd/MM/yyyy HH:mm\}}"/>

                            --><!-- MaxDeliveryTime --><!--
                            <Label Grid.Row="10" Grid.Column="0" Content="Max Delivery Time:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding MaxDeliveryTime, StringFormat=\{0:dd/MM/yyyy HH:mm\}}"/>

                            --><!-- OrderStatus --><!--
                            <Label Grid.Row="11" Grid.Column="0" Content="Order Status:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding OrderStatus}"/>

                            --><!-- ScheduleStatus --><!--
                            <Label Grid.Row="12" Grid.Column="0" Content="Schedule Status:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding ScheduleStatus}"/>

                            --><!-- RemainingTime --><!--
                            <Label Grid.Row="13" Grid.Column="0" Content="Remaining Time:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding RemainingTime}"/>


                            --><!-- Inline ComboBox for end status + Close Button --><!--
                            <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" 
                                        Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">

                                --><!-- ComboBox to choose end status--><!--
                                <ComboBox Width="150" Height="25"
          ItemsSource="{Binding Source={StaticResource EndStatusCollectionKey}}"
          SelectedItem="{Binding SelectedEndDeliveryStatus, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"/>


                                --><!-- Button close delivery --><!--
                                <Button Content="Close Delivery" Width="120" Height="30"
                                        Click="BtnClose_Click"/>

                            </StackPanel>

                            --><!-- BUTTON --><!--
                            <Button x:Name="btnAddUpdate"
                Grid.Row="13" Grid.ColumnSpan="2" 
                Content="{Binding ButtonText, FallbackValue='Add / Update'}" 
                Height="40" Width="305" Margin="0,20,0,0"
                Click="btnAddUpdate_Click"/>

                            --><!--Select order and deliveries history--><!--
                            <Grid Grid.Row="13" Grid.ColumnSpan="2"
                  Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                --><!--select order button--><!--
                                <Button Content="Select an Order"        
                        Width="150" Height="30"       
                        HorizontalAlignment="Right"        
                        Grid.Column="0"
                        Click="BtnSelectOrder_Click">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{StaticResource CourierEnableConverterKey}">
                                            <Binding Path="CurrentCourier.Active" />
                                            <Binding Path="CurrentCourier.ActiveDeliveryOrder" />
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                </Button>
                                --><!--deliveries-history button--><!--
                                <Button Content="Deliveries History"
                        Width="150" Height="30"
                        HorizontalAlignment="Left"
                        Grid.Column="2"
                        Click="BtnDeliveriesHistory_Click"
                        Visibility="{Binding HistoryVisibility}"/>
                            </Grid>
                        </Grid>
                    </Grid>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Window>-->
<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Courier"
        xmlns:pl="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Courier Window" Height="650" Width="800"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <pl:ConvertModeToReadOnly x:Key="ModeToReadOnly"/>
        <pl:ConvertModeToVisibility x:Key="ModeToVisibility"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="0,3,0,3"/>
                    <Setter Property="Height" Value="25"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
                <Style TargetType="Label">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <Label Grid.Row="0" Grid.Column="0" Content="ID:"/>
            <TextBox Grid.Row="0" Grid.Column="1" 
                     Text="{Binding CurrentCourier.Id, Mode=TwoWay}" 
                     IsReadOnly="{Binding ElementName=btnAddUpdate,
                                          Path=Content,
                                          Converter={StaticResource ModeToReadOnly}}"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Name:"/>
            <TextBox Grid.Row="1" Grid.Column="1" 
                     Text="{Binding CurrentCourier.Name, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Phone:"/>
            <TextBox Grid.Row="2" Grid.Column="1" 
                     Text="{Binding CurrentCourier.CourierPhone, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Row="3" Grid.Column="0" Content="Email:"/>
            <TextBox Grid.Row="3" Grid.Column="1" 
                     Text="{Binding CurrentCourier.Email, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Row="4" Grid.Column="0" Content="Password:"/>
            <TextBox Grid.Row="4" Grid.Column="1" 
                     Text="{Binding CurrentCourier.Password, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Row="5" Grid.Column="0" Content="Active:"/>
            <CheckBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="0,5"
                      IsChecked="{Binding CurrentCourier.Active, Mode=TwoWay}"/>

            <Label Grid.Row="6" Grid.Column="0" Content="Delivery Method:"/>
            <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,3" Height="25"
                      ItemsSource="{Binding Source={StaticResource MethodDeliveryCollectionKey}}"
                      SelectedItem="{Binding CurrentCourier.DeliveryMethod, Mode=TwoWay}"/>

            <Label Grid.Row="7" Grid.Column="0" Content="Started Working:"/>
            <DatePicker Grid.Row="7" Grid.Column="1" Margin="0,3" VerticalAlignment="Center"
                        SelectedDate="{Binding CurrentCourier.StartedWorking, Mode=TwoWay}" 
                        IsEnabled="False"/>

            <Label Grid.Row="8" Grid.Column="0" Content="Max Distance:"/>
            <TextBox Grid.Row="8" Grid.Column="1" 
                     Text="{Binding CurrentCourier.MaxPersonalDistance, Mode=TwoWay, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>

            <Label Grid.Row="9" Grid.Column="0" Content="On Time Deliveries:"
                   Visibility="{Binding ElementName=btnAddUpdate,
                                        Path=Content,
                                        Converter={StaticResource ModeToVisibility}}"/>

            <TextBox Grid.Row="9" Grid.Column="1" 
                     Text="{Binding CurrentCourier.TotalOnTimeDeliveries, Mode=OneWay}" 
                     IsReadOnly="True"
                     Visibility="{Binding ElementName=btnAddUpdate,
                                          Path=Content,
                                          Converter={StaticResource ModeToVisibility}}"/>

            <Label Grid.Row="10" Grid.Column="0" Content="Late Deliveries:"
                   Visibility="{Binding ElementName=btnAddUpdate,
                                        Path=Content,
                                        Converter={StaticResource ModeToVisibility}}"/>

            <TextBox Grid.Row="10" Grid.Column="1" 
                     Text="{Binding CurrentCourier.TotalLateDeliveries, Mode=OneWay}" 
                     IsReadOnly="True" 
                     Visibility="{Binding ElementName=btnAddUpdate,
                                          Path=Content,
                                          Converter={StaticResource ModeToVisibility}}"/>

            <GroupBox Header="Order In Progress"          
                      Grid.Row="12" Grid.ColumnSpan="2" Margin="0,10,0,0"
                      Visibility="{Binding CurrentCourier.ActiveDeliveryOrder,
                                   Converter={StaticResource NullToVisibility}}">
                <Grid DataContext="{Binding CurrentCourier.ActiveDeliveryOrder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Delivery ID:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeliveryId}" VerticalAlignment="Center"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Order ID:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OrderId}" VerticalAlignment="Center"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Order Type:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrderType}" VerticalAlignment="Center"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Description:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="Address:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Address}" VerticalAlignment="Center"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="Aerial Distance:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AerialDistance}" VerticalAlignment="Center"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="Actual Distance:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ActualDistance}" VerticalAlignment="Center"/>

                        <Label Grid.Row="7" Grid.Column="0" Content="Customer Name:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CustomerName}" VerticalAlignment="Center"/>

                        <Label Grid.Row="8" Grid.Column="0" Content="Customer Phone:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CustomerPhone}" VerticalAlignment="Center"/>

                        <Label Grid.Row="9" Grid.Column="0" Content="Expected Delivery Time:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ExpectedDeliveryTime, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" VerticalAlignment="Center"/>

                        <Label Grid.Row="10" Grid.Column="0" Content="Max Delivery Time:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding MaxDeliveryTime, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" VerticalAlignment="Center"/>

                        <Label Grid.Row="11" Grid.Column="0" Content="Order Status:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding OrderStatus}" VerticalAlignment="Center"/>

                        <Label Grid.Row="12" Grid.Column="0" Content="Schedule Status:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding ScheduleStatus}" VerticalAlignment="Center"/>

                        <Label Grid.Row="13" Grid.Column="0" Content="Remaining Time:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding RemainingTime}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" 
                                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">

                            <ComboBox Width="150" Height="25"
                                      ItemsSource="{Binding Source={StaticResource EndStatusCollectionKey}}"
                                      SelectedItem="{Binding SelectedEndDeliveryStatus, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}"/>

                            <Button Content="Close Delivery" Width="120" Height="30" Margin="10,0,0,0"
                                    Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>

            <Button x:Name="btnAddUpdate"
                    Grid.Row="14" Grid.ColumnSpan="2" 
                    Content="{Binding ButtonText, FallbackValue='Add / Update'}" 
                    Height="40" Width="305" Margin="0,10,0,10"
                    Click="btnAddUpdate_Click"/>

            <Grid Grid.Row="15" Grid.ColumnSpan="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="Select an Order"       
                        Width="150" Height="30"        
                        HorizontalAlignment="Right"        
                        Grid.Column="0"
                        Click="BtnSelectOrder_Click">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource CourierEnableConverterKey}">
                            <Binding Path="CurrentCourier.Active" />
                            <Binding Path="CurrentCourier.ActiveDeliveryOrder" />
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>

                <Button Content="Deliveries History"
                        Width="150" Height="30"
                        HorizontalAlignment="Left"
                        Grid.Column="2"
                        Click="BtnDeliveriesHistory_Click"
                        Visibility="{Binding HistoryVisibility}"/>
            </Grid>

        </Grid>
    </ScrollViewer>
</Window>
