<Window x:Class="PL.Delivery.DeliveryHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Delivery"
        mc:Ignorable="d"
        Title="DeliveryHistory" Height="650" Width="800"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
    </Window.Resources>
     
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <!--can be sorted too-->
                <Label Content="Filter by End order type:" VerticalAlignment="Center"/>
                <ComboBox Width="150" Margin="10,0"
                          SelectedItem="{Binding OrderTypeFilter, Mode=TwoWay}"
                          ItemsSource="{Binding Source={StaticResource OrderTypeCollectionKey}}"
                          SelectionChanged="CmbStatusFilter_SelectionChanged"/>
                          
                <Button Content="Clear Filter" Click="BtnClearFilter_Click" Margin="5,0" Padding="5,2"/>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding DeliveryHistoryList}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False" 
                  EnableRowVirtualization="True"
                  RowHeight="40"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="LightGray"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  Margin="10">
            

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding DeliveryId}" Header="Delivery ID" Width="Auto" FontWeight="Bold"/>
                <DataGridTextColumn Binding="{Binding OrderId}" Header="Order ID" Width="Auto"/>

                <DataGridTextColumn Binding="{Binding OrderType}" Header="Order Type" Width="Auto"/>

                <DataGridTextColumn Binding="{Binding Address}" Header="Address" Width="Auto"/>

                <DataGridTextColumn Binding="{Binding DeliveryMethod}" Header="Delivery Method" Width="Auto"/>

                <DataGridTextColumn Binding="{Binding DistanceInKm}" Header="Distance" Width="Auto"/>

                <DataGridTextColumn Binding="{Binding TotalDeliveryTime, StringFormat=hh\\:mm\\:ss}" Header="Total Time" Width="Auto"/>

                <DataGridTemplateColumn Header="End Status" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="5" Padding="5,2" Background="#E0E0E0" Margin="2">
                                <TextBlock Text="{Binding EndDeliveryStatus}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
